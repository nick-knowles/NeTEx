<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns="http://www.netex.org.uk/netex" xmlns:netex="http://www.netex.org.uk/netex" xmlns:siri="http://www.siri.org.uk/siri" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.netex.org.uk/netex" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2.0" id="netex_accessRightValidation_support">
	<xsd:include schemaLocation="netex_accessRightControl_support.xsd"/>
	<!-- =============================================================== -->
	<xsd:annotation>
		<xsd:appinfo>
			<Metadata xmlns="http://www.govtalk.gov.uk/CM/gms-xs">
				<Aggregation>main schema</Aggregation>
				<Audience>e-service developers</Audience>
				<Coverage>Europe</Coverage>
				<Creator>Nick Knowles</Creator>
				<Date>
					<Created>2023-12-15</Created>
					Provide basic validation elements
				</Date>
				<Description>
					<p>NeTEx is a European CEN standard for the exchange of Public Transport data including timetables.</p>
					<p>This sub-schema describes the ACCESS RIGHT VALIDATION types.</p>
				</Description>
				<Format>
					<MediaType>text/xml</MediaType>
					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>
					<Description>XML schema, W3C Recommendation 2001</Description>
				</Format>
				<Language>[ISO 639-2/B] ENG</Language>
				<Rights>Unclassified
					 <Copyright>CEN, Crown Copyright 2009-2023</Copyright>
				</Rights>
				<Source>
					<ul>
						<li>Derived from the Transmodel  standard.</li>
					</ul>
				</Source>
				<Status>Version 1.0 Draft for approval</Status>
				<Subject>
					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,
Air transport, Airports,
Ports and maritime transport, Ferries (marine),
Public transport, Bus services, Coach services, Bus stops and stations,
Rail transport, Railway stations and track, Train services, Underground trains,
Business and industry, Transport, Air transport , Ports and maritime transport, Public transport,
Rail transport, Roads and Road transport
</Category>
					<Project>CEN TC278 WG3 SG9.</Project>
				</Subject>
				<Title>NeTEx ACCESS RIGHT VALIDATION identifier types.</Title>
				<Type>Standard</Type>
			</Metadata>
		</xsd:appinfo>
		<xsd:documentation>NeTEx: ACCESS RIGHT VALIDATION identifier types.</xsd:documentation>
	</xsd:annotation>
	<!-- ==== VALIDATION ENTRY ======================================= -->
	<xsd:complexType name="validationEntryRefs_RelStructure">
		<xsd:annotation>
			<xsd:documentation>Type for a list of  references to  VALIDATION ENTRies.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="oneToManyRelationshipStructure">
				<xsd:sequence>
					<xsd:element ref="ValidationEntryRef" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:simpleType name="ValidationEntryIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a VALIDATION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="FareContractEntryIdType"/>
	</xsd:simpleType>
	<xsd:element name="ValidationEntryRef" type="ValidationEntryRefStructure" substitutionGroup="FareContractEntryRef">
		<xsd:annotation>
			<xsd:documentation>Reference to a VALIDATION ENTRY.  +v2.0</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="ValidationEntryRefStructure">
		<xsd:annotation>
			<xsd:documentation>Type for Reference to a VALIDATION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="FareContractEntryRefStructure">
				<xsd:attribute name="ref" type="ValidationEntryIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a VALIDATION ENTRY.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<!-- ====CONTROLLED ACCESS ================================== -->
	<xsd:simpleType name="ControlledAccessIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a CONTROLLED ACCESS.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="ControlRecordIdType"/>
	</xsd:simpleType>
	<xsd:element name="ControlledAccessRef" type="ControlledAccessRefStructure" substitutionGroup="ControlRecordRef">
		<xsd:annotation>
			<xsd:documentation>Reference to a CONTROLLED ACCESS. +v2.0</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="ControlledAccessRefStructure">
		<xsd:annotation>
			<xsd:documentation>Type for Reference to a CONTROLLED ACCESS.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="ControlRecordRefStructure">
				<xsd:attribute name="ref" type="ControlledAccessIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a CONTROLLED ACCESS.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<!-- ==== VALIDATED  ACCESS ================================== -->
	<xsd:simpleType name="ValidatedAccessIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a VALIDATED ACCESS.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="ControlRecordIdType"/>
	</xsd:simpleType>
	<xsd:element name="ValidatedAccessRef" type="ValidatedAccessRefStructure" substitutionGroup="ControlRecordRef">
		<xsd:annotation>
			<xsd:documentation>Reference to a VALIDATED ACCESS. +v2.0</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="ValidatedAccessRefStructure">
		<xsd:annotation>
			<xsd:documentation>Type for Reference to a VALIDATED ACCESS.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="ControlRecordRefStructure">
				<xsd:attribute name="ref" type="ValidatedAccessIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a VALIDATED ACCESS.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<!-- ====ACCESSED FARE STRUCTURE ELEMENT ================================== -->
	<xsd:simpleType name="AccessedFareStructureElementIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a ACCESSED FARE STRUCTURE ELEMENT.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="ObjectIdType"/>
	</xsd:simpleType>
	<xsd:element name="AccessedFareStructureElementRef" type="AccessedFareStructureElementRefStructure" substitutionGroup="VersionOfObjectRef">
		<xsd:annotation>
			<xsd:documentation>Reference to a ACCESSED FARE STRUCTURE ELEMENT.  +v2.0</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="AccessedFareStructureElementRefStructure">
		<xsd:annotation>
			<xsd:documentation>Type for Reference to a ACCESSED FARE STRUCTURE ELEMENT.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="VersionOfObjectRefStructure">
				<xsd:attribute name="ref" type="AccessedFareStructureElementIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a ACCESSED FARE STRUCTURE ELEMENT.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<!-- ==== ACCESSED FARE STRUCTURE ELEMENT ================================== -->
	<xsd:complexType name="offenceRefs_RelStructure">
		<xsd:annotation>
			<xsd:documentation>Type for a list of references to an OFFENCE.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="oneToManyRelationshipStructure">
				<xsd:sequence>
					<xsd:element ref="OffenceRef" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:simpleType name="OffenceIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a OFFENCE.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="ObjectIdType"/>
	</xsd:simpleType>
	<xsd:element name="OffenceRef" type="OffenceRefStructure" substitutionGroup="VersionOfObjectRef">
		<xsd:annotation>
			<xsd:documentation>Reference to a OFFENCE.  +v2.0</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="OffenceRefStructure">
		<xsd:annotation>
			<xsd:documentation>Type for Reference to a OFFENCE.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="VersionOfObjectRefStructure">
				<xsd:attribute name="ref" type="OffenceIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a OFFENCE.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<!-- ==== TYPE OF OFFENCE =============================================== -->
	<xsd:complexType name="typeOfOffenceRefs_RelStructure">
		<xsd:annotation>
			<xsd:documentation>Type for a list of TYPEs OF OFFENCE.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="oneToManyRelationshipStructure">
				<xsd:sequence>
					<xsd:element ref="TypeOfOffenceRef" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:simpleType name="TypeOfOffenceIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a TYPE OF OFFENCE.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="TypeOfValueIdType"/>
	</xsd:simpleType>
	<xsd:element name="TypeOfOffenceRef" type="TypeOfOffenceRefStructure" substitutionGroup="TypeOfEntityRef">
		<xsd:annotation>
			<xsd:documentation>Reference to a TYPE OF OFFENCE. +v2.0</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="TypeOfOffenceRefStructure">
		<xsd:annotation>
			<xsd:documentation>Type for Reference to a TYPE OF OFFENCE.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="TypeOfValueRefStructure">
				<xsd:attribute name="ref" type="TypeOfOffenceIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a TYPE OF OFFENCE.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<!-- === CONTROL PARAMETER ASSIGNMENT =========================================== -->
	<xsd:simpleType name="ValidationParameterAssignmentIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a VALIDATION PARAMETER ASSIGNMENT.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="AccessRightParameterAssignmentIdType"/>
	</xsd:simpleType>
	<xsd:complexType name="ValidationParameterAssignmentRefStructure">
		<xsd:annotation>
			<xsd:documentation>Type for Reference to a VALIDATION PARAMETER ASSIGNMENT.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="AccessRightParameterAssignmentRefStructure">
				<xsd:attribute name="ref" type="ValidationParameterAssignmentIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a VALIDATION PARAMETER ASSIGNMENT.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
</xsd:schema>
