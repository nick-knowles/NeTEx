	<!-- ====REVENUE PROTECTION ENTRY ========================================== -->
	<xsd:complexType name="revenueProtectionEntries_RelStructure">
		<xsd:annotation>
			<xsd:documentation>Type for a list of REVENUE PROTECTION ENTRies.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="containmentAggregationStructure">
				<xsd:choice>
					<xsd:element ref="RevenueProtectionEntry_DummyType" maxOccurs="unbounded"/>
					<xsd:element ref="RevenueProtectionEntryRef" maxOccurs="unbounded"/>
				</xsd:choice>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:element name="RevenueProtectionEntry_DummyType" type="DataManagedObjectStructure" abstract="true" substitutionGroup="FareContractEntry_">
		<xsd:annotation>
			<xsd:documentation>Dummy type for REVENUE PROTECTION ENTRY.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="RevenueProtectionEntry" abstract="true" substitutionGroup="RevenueProtectionEntry_DummyType">
		<xsd:annotation>
			<xsd:documentation>An abstract FARE CONTRACT ENTRY representing the recording of an event relating to revenue protection.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:restriction base="RevenueProtectionEntry_VersionStructure">
					<xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="EntityInVersionGroup" minOccurs="0"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="DataManagedObjectGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="LogEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="FareContractEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="RevenueProtectionEntryGroup"/>
						</xsd:sequence>
					</xsd:sequence>
					<xsd:attribute name="id" type="RevenueProtectionEntryIdType" use="optional">
						<xsd:annotation>
							<xsd:documentation>Identifier of REVENUE PROTECTION ENTITY.</xsd:documentation>
						</xsd:annotation>
					</xsd:attribute>
				</xsd:restriction>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="RevenueProtectionEntry_VersionStructure">
		<xsd:annotation>
			<xsd:documentation>Type for REVENUE PROTECTION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="FareContractEntry_VersionStructure">
				<xsd:sequence>
					<xsd:group ref="RevenueProtectionEntryGroup"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="RevenueProtectionEntryGroup">
		<xsd:annotation>
			<xsd:documentation>Elements for REVENUE PROTECTION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element ref="CustomerAccountRef" minOccurs="0"/>
			<xsd:element ref="ValidationEntryRef" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<!-- ==== NO ACCESS RIGHTS ENTRY =========================================== -->
	<xsd:element name="NoAccessRightsEntry" abstract="false" substitutionGroup="RevenueProtectionEntry_DummyType">
		<xsd:annotation>
			<xsd:documentation>A REVENUE PROTECTION ENTRY recording the detection of a TRANSPORT CUSTOMER travelling without having purchased access rights.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:restriction base="NoAccessRightsEntry_VersionStructure">
					<xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="DataManagedObjectGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="LogEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="FareContractEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="RevenueProtectionEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="NoAccessRightsEntryGroup"/>
							<!--		<xsd:group ref="RevenueProtectionEntryLocationGroup"/> -->
						</xsd:sequence>
					</xsd:sequence>
					<xsd:attribute name="id" type="NoAccessRightsEntryIdType"/>
				</xsd:restriction>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="NoAccessRightsEntry_VersionStructure">
		<xsd:annotation>
			<xsd:documentation>Type for NO ACCESS RIGHTS ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="RevenueProtectionEntry_VersionStructure">
				<xsd:sequence>
					<xsd:group ref="NoAccessRightsEntryGroup"/>
					<!--		<xsd:group ref="RevenueProtectionEntryLocationGroup"/> -->
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="NoAccessRightsEntryGroup">
		<xsd:annotation>
			<xsd:documentation>Elements for NO ACCESS RIGHTS ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<!-- No specific content -->
			<xsd:element ref="TravelDocumentRef" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<!-- ==== INSUFFICIENT ACCESS RIGHTS ENTRY =========================================== -->
	<xsd:element name="InsufficientAccessRightsEntry" abstract="false" substitutionGroup="RevenueProtectionEntry_DummyType">
		<xsd:annotation>
			<xsd:documentation>A REVENUE PROTECTION ENTRY recording the result of the comparison between one or several CONTROL ENTRies and the theoretical access rights attached to the TRAVEL DOCUMENT controlled, detecting insufficient rights to consume and possibly giving rise to a FARE DEBIT or one or more OFFENCEs.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:restriction base="InsufficientAccessRightsEntry_VersionStructure">
					<xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="DataManagedObjectGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="LogEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="FareContractEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="RevenueProtectionEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="InsufficientAccessRightsEntryGroup"/>
							<!--	<xsd:group ref="RevenueProtectionEntryLocationGroup"/> -->
						</xsd:sequence>
					</xsd:sequence>
					<xsd:attribute name="id" type="InsufficientAccessRightsEntryIdType"/>
				</xsd:restriction>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="InsufficientAccessRightsEntry_VersionStructure">
		<xsd:annotation>
			<xsd:documentation>Type for NO ACCESS RIGHTS ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="RevenueProtectionEntry_VersionStructure">
				<xsd:sequence>
					<xsd:group ref="InsufficientAccessRightsEntryGroup"/>
					<!--	<xsd:group ref="RevenueProtectionEntryLocationGroup"/> -->
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="InsufficientAccessRightsEntryGroup">
		<xsd:annotation>
			<xsd:documentation>Elements for NO ACCESS RIGHTS ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element ref="TravelDocumentRef"/>
		</xsd:sequence>
	</xsd:group>
	<!-- ==== NO PROOF ON PERSON ENTRY =========================================== -->
	<xsd:element name="NoProofOnPersonEntry" abstract="false" substitutionGroup="RevenueProtectionEntry_DummyType">
		<xsd:annotation>
			<xsd:documentation>A REVENUE PROTECTION ENTRY recording the detection of a TRANSPORT CUSTOMER travelling without having purchased access rights.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:restriction base="NoProofOnPersonEntry_VersionStructure">
					<xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="DataManagedObjectGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="LogEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="FareContractEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="RevenueProtectionEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="NoProofOnPersonEntryGroup"/>
						</xsd:sequence>
					</xsd:sequence>
					<xsd:attribute name="id" type="NoProofOnPersonEntryIdType"/>
				</xsd:restriction>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="NoProofOnPersonEntry_VersionStructure">
		<xsd:annotation>
			<xsd:documentation>Type for NO PROOF ON PERSON ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="RevenueProtectionEntry_VersionStructure">
				<xsd:sequence>
					<xsd:group ref="NoProofOnPersonEntryGroup"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="NoProofOnPersonEntryGroup">
		<xsd:annotation>
			<xsd:documentation>Elements for NO PROOF ON PERSON ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence/>
	</xsd:group>
	<!-- ==== TRAVEL DOCUMENT CONFISCATION ENTRY =========================================== -->
	<xsd:element name="TravelDocumentConfiscationEntry" abstract="false" substitutionGroup="RevenueProtectionEntry_DummyType">
		<xsd:annotation>
			<xsd:documentation>A REVENUE PROTECTION ENTRY recording the detection of a TRANSPORT CUSTOMER travelling without having purchased access rights.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:restriction base="TravelDocumentConfiscationEntry_VersionStructure">
