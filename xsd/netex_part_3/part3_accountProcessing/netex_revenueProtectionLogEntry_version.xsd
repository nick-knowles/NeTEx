	<xsd:complexType name="TravelDocumentConfiscationEntry_VersionStructure">
		<xsd:annotation>
			<xsd:documentation>Type for TRAVEL DOCUMENT CONFISCATION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="RevenueProtectionEntry_VersionStructure">
