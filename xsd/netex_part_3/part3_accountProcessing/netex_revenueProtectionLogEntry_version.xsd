						<xsd:sequence>
							<xsd:group ref="LogEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="FareContractEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="RevenueProtectionEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="TravelDocumentConfiscationEntryGroup"/>
							<!--		<xsd:group ref="RevenueProtectionEntryLocationGroup"/> -->
						</xsd:sequence>
					</xsd:sequence>
					<xsd:attribute name="id" type="TravelDocumentConfiscationEntryIdType"/>
				</xsd:restriction>
			</xsd:complexContent>
		</xsd:complexType>
