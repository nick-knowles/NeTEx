		<xsd:annotation>
			<xsd:documentation>Elements for TRAVEL DOCUMENT CONFISCATION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element ref="TravelDocumentRef"/>
		</xsd:sequence>
	</xsd:group>
	<!-- ==== SUSPICIOUS BEHAVIOUR ENTRY =========================================== -->
	<xsd:element name="SuspiciousBehaviourEntry" abstract="false" substitutionGroup="RevenueProtectionEntry_DummyType">
		<xsd:annotation>
			<xsd:documentation>A REVENUE PROTECTION EVENT recording the detection of suspicious behaviour.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:restriction base="SuspiciousBehaviourEntry_VersionStructure">
					<xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="DataManagedObjectGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="LogEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="FareContractEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="RevenueProtectionEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="SuspiciousBehaviourEntryGroup"/>
						</xsd:sequence>
					</xsd:sequence>
					<xsd:attribute name="id" type="SuspiciousBehaviourEntryIdType"/>
				</xsd:restriction>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="SuspiciousBehaviourEntry_VersionStructure">
		<xsd:annotation>
			<xsd:documentation>Type for SUSPICIOUS BEHAVIOUR ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="RevenueProtectionEntry_VersionStructure">
				<xsd:sequence>
					<xsd:group ref="SuspiciousBehaviourEntryGroup"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="SuspiciousBehaviourEntryGroup">
		<xsd:annotation>
			<xsd:documentation>Elements for SUSPICIOUS BEHAVIOUR ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<!-- No specific content -->
			<xsd:element name="indicatiedByEntries" type="revenueProtectionEntryRefs_RelStructure" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<!-- ==== SECURITY LIST CHECK FAIL ENTRY =========================================== -->
	<xsd:element name="SecurityListCheckFailEntry" abstract="false" substitutionGroup="RevenueProtectionEntry_DummyType">
		<xsd:annotation>
			<xsd:documentation>A REVENUE PROTECTION ENTRY recording the failure to pass a security check, either through being on a BLACKLIST being or not on a required WHITE LIST.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:restriction base="SecurityListCheckFailEntry_VersionStructure">
					<xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="DataManagedObjectGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="LogEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="FareContractEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="RevenueProtectionEntryGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="SecurityListCheckFailEntryGroup"/>
						</xsd:sequence>
					</xsd:sequence>
					<xsd:attribute name="id" type="SecurityListCheckFailEntryIdType"/>
				</xsd:restriction>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="SecurityListCheckFailEntry_VersionStructure">
		<xsd:annotation>
			<xsd:documentation>Type for SECURITY LIST CHECK FAIL ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="RevenueProtectionEntry_VersionStructure">
				<xsd:sequence>
					<xsd:group ref="SecurityListCheckFailEntryGroup"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="SecurityListCheckFailEntryGroup">
		<xsd:annotation>
			<xsd:documentation>Elements for SECURITY LIST CHECK FAIL ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<!-- No specific content -->
			<xsd:element ref="SecurityListRef"/>
			<xsd:element ref="SecurityListingRef" minOccurs="0"/>
			<xsd:group ref="SecurityListParametersGroup">
				<xsd:annotation>
					<xsd:documentation>Elements that failed check </xsd:documentation>
				</xsd:annotation>
			</xsd:group>
		</xsd:sequence>
	</xsd:group>
	<xsd:group name="SecurityListParametersGroup">
		<xsd:annotation>
			<xsd:documentation>Elements for SECURITY LIST CHECK FAIL ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:choice>
			<!-- No specific content -->
			<xsd:element ref="CustomerRef"/>
			<xsd:element ref="CustomerAccountRef"/>
			<xsd:element ref="FareContractRef"/>
			<xsd:element ref="TravelDocumentRef"/>
			<xsd:element ref="MediumAccessDeviceRef"/>
		</xsd:choice>
	</xsd:group>
</xsd:schema>
