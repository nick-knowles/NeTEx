			<xsd:documentation>Type for Reference to a CUSTOMER MEDIA REGISTRATION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="LogEntryRefStructure">
				<xsd:attribute name="ref" type="CustomerMediaRegistrationEntryIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a CUSTOMER MEDIA REGISTRATION ENTRY.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<!-- ====CUSTOMER REGISTRATION ENTRY ========================================= -->
	<xsd:simpleType name="CustomerRegistrationEntryIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a CUSTOMER REGISTRATION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="CustomerAccountEntryIdType"/>
	</xsd:simpleType>
	<xsd:element name="CustomerRegistrationEntryRef" type="CustomerRegistrationEntryRefStructure" abstract="false" substitutionGroup="CustomerAccountEntryRef">
		<xsd:annotation>
			<xsd:documentation>Reference to a CUSTOMER REGISTRATION ENTRY. +v2.0</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="CustomerRegistrationEntryRefStructure">
		<xsd:annotation>
			<xsd:documentation>Type for Reference to a CUSTOMER REGISTRATION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="CustomerAccountEntryRefStructure">
				<xsd:attribute name="ref" type="CustomerRegistrationEntryIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a CUSTOMER REGISTRATION ENTRY.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<!-- ====CUSTOMER DEREGISTRATION ENTRY =============================================== -->
	<xsd:simpleType name="CustomerDeregistrationEntryIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a CUSTOMER DEREGISTRATION ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="CustomerAccountEntryIdType"/>
	</xsd:simpleType>
	<xsd:element name="CustomerDeregistrationEntryRef" type="CustomerDeregistrationEntryRefStructure" abstract="false" substitutionGroup="CustomerAccountEntryRef">
