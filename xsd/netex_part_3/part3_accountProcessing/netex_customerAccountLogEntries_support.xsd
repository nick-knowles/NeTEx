				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<!-- ====RESTORE CUSTOMER ACCOUNT ENTRY =============================================== -->
	<xsd:simpleType name="RestoreCustomerAccountEntryIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a RESTORE CUSTOMER ACCOUNT ENTRY.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="CustomerAccountEntryIdType"/>
