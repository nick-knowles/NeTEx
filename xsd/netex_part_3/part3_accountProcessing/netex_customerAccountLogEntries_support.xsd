	<xsd:element name="RestoreCustomerAccountEntryRef" type="RestoreCustomerAccountEntryRefStructure" abstract="false" substitutionGroup="CustomerAccountEntryRef">
		<xsd:annotation>
			<xsd:documentation>Reference to a RESTORE CUSTOMER ACCOUNT ENTRY. +v2.0</xsd:documentation>
