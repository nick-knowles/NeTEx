	<!-- ======================================================================= -->
	<xsd:simpleType name="ControlAndValidationFrameIdType">
		<xsd:annotation>
			<xsd:documentation>Type for identifier of a CONTROL AND VALIDATION FRAME.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="VersionFrameIdType"/>
	</xsd:simpleType>
	<xsd:element name="ControlAndValidationFrameRef" type="ControlAndValidationFrameRefStructure" abstract="false" substitutionGroup="VersionFrameRef">
		<xsd:annotation>
			<xsd:documentation>Reference to a CONTROL AND VALIDATION FRAME.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="ControlAndValidationFrameRefStructure">
		<xsd:annotation>
			<xsd:documentation>Type for a reference to a CONTROL AND VALIDATION FRAME.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:restriction base="VersionFrameRefStructure">
				<xsd:attribute name="ref" type="ControlAndValidationFrameIdType" use="required">
					<xsd:annotation>
						<xsd:documentation>Identifier of a CONTROL AND VALIDATION FRAME.</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:element name="ControlAndValidationFrame" substitutionGroup="CommonFrame">
		<xsd:annotation>
			<xsd:documentation>A coherent set of Vehicle Scheduling data to which the same VALIDITY CONDITIONs have been assigned.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:restriction base="ControlAndValidationFrame_VersionFrameStructure">
					<xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="EntityInVersionGroup" minOccurs="0"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="DataManagedObjectGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="VersionFrameGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="ControlAndValidationFrameGroup"/>
						</xsd:sequence>
					</xsd:sequence>
					<xsd:attribute name="id" type="ControlAndValidationFrameIdType"/>
				</xsd:restriction>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<!-- ====CONTROL AND VALIDATION  FAME======================================================= -->
	<xsd:complexType name="ControlAndValidationFrame_VersionFrameStructure">
		<xsd:annotation>
			<xsd:documentation>Type for a CONTROL AND VALIDATION FRAME.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="Common_VersionFrameStructure">
				<xsd:sequence>
					<xsd:group ref="ControlAndValidationFrameGroup"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="ControlAndValidationFrameGroup">
		<xsd:annotation>
			<xsd:documentation>Elements for a CONTROL AND VALIDATION FRAME.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:group ref="ControlMeansInFrameGroup"/>
			<xsd:group ref="ControlEntriesInFrameGroup"/>
			<xsd:group ref="ValidationEntriesInFrameGroup"/>
		</xsd:sequence>
	</xsd:group>
	<!-- ====Journey========================================-->
</xsd:schema>
